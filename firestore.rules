rules_version = '2';

// Pravidla — M0 (§4.3, §5) + M1 (Organizace, zaměstnanci, Spis, Dítě,
// Pěstoun jako osoba). Rozšiřuje se modul po modulu, nikdy najednou pro
// kolekce, které ještě neexistují v kódu.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Sdílené helpery ----------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // §5: role se čte VÝHRADNĚ z Firestore users/{uid}, NIKDY z Custom Claims.
    // Pozn.: rules jazyk nepodporuje top-level const — seznamy rolí jsou
    // proto inline v každé funkci (drž obě definice synchronní se
    // src/types/user.ts STAFF_ROLES / READ_ONLY_MANAGER_ROLES) — S JEDNOU
    // VĚDOMOU VÝJIMKOU: 'spolupracovnik' JE v STAFF_ROLES (M9, UX zpětná
    // vazba 2026-07-21 — má normální staff login/účet), ale záměrně NENÍ
    // tady v `isStaff()`. `isStaff()`/`sameOrg()` dávají ŠIROKÝ přístup
    // (celá organizace) — spolupracovník má dostat jen to, co mu KO/vedení
    // výslovně přiřadí (`collaboratorAssignments`), ne totéž, co
    // `zamestnanec`. Viz `isCollaborator()`/`hasCollaboratorAssignment()`
    // níž pro jeho VLASTNÍ, úzký gate.
    function isStaff() {
      return isSignedIn() && userDoc().role in [
        'superadmin', 'org_admin', 'vedouci_pobocky', 'teamleader',
        'klicova_osoba', 'asistent_ko', 'zamestnanec'
      ];
    }

    function isReadOnlyManager() {
      return isSignedIn() && userDoc().role in ['vedouci_pobocky', 'teamleader'];
    }

    // M4 (§6 A6): pěstoun má VLASTNÍ, úzký profil (role 'pestoun', mimo
    // `isStaff()` seznam) — `fosterFamilyId`/`fosterPersonRef` na jeho
    // `users/{uid}` dokumentu (src/types/user.ts) ukazují na PŘESNĚ jednu
    // rodinu/osobu. Nikdy nekombinovat s `sameOrg()` (ta je jen pro staff,
    // viz "Klíčová past" komentář výš) — pěstounovo scoping jde vždy přes
    // tuhle funkci + přímé porovnání `familyId`.
    function isFoster() {
      return isSignedIn() && userDoc().role == 'pestoun';
    }

    function isSuperadmin() {
      return isSignedIn() && userDoc().role == 'superadmin';
    }

    // M9 (UX zpětná vazba 2026-07-21) — Spolupracovník: STAFF_ROLES, ale
    // NE `isStaff()` (viz komentář tam). Přístup jde VÝHRADNĚ přes
    // konkrétní `collaboratorAssignments/{uid}_{entityType}_{entityId}`
    // dokument (deterministické ID, stejný vzor jako Dohoda) — žádné
    // `sameOrg()`, žádný obecný organizační přístup.
    function isCollaborator() {
      return isSignedIn() && userDoc().role == 'spolupracovnik';
    }

    function hasCollaboratorAssignment(entityType, entityId) {
      let assignmentPath = /databases/$(database)/documents/collaboratorAssignments/$(request.auth.uid + '_' + entityType + '_' + entityId);
      return isCollaborator() &&
        exists(assignmentPath) &&
        get(assignmentPath).data.organizationId == userDoc().organizationId;
    }

    // Bezpečné čtení mapy — `collaboratorModules` chybí, dokud ho org_admin
    // poprvé nenastaví (i prázdné `{}` při založení role, viz StaffPage.tsx);
    // `!= null` guard napřed zabraňuje "property na null" chybě.
    function collaboratorModuleEnabled(key) {
      return isCollaborator() &&
        userDoc().collaboratorModules != null &&
        userDoc().collaboratorModules[key] == true;
    }

    // §5 "Klíčová past": sameOrg() musí být VŽDY gated za isStaff() — pěstoun
    // i externí účastník mají taky organizationId, holé sameOrg by jim
    // otevřelo celou organizaci. Nikde nepoužívej sameOrg() bez isStaff()
    // (nebo bez vlastního úzkého disjunktu pro pěstouna/EP přes profil).
    function sameOrg(orgId) {
      return isStaff() && userDoc().organizationId == orgId;
    }

    // M1: self-service registrace (§6 A9) potřebuje rozeznat "úplně nový,
    // ještě neusazený uživatel" — ten smí jednou založit organizaci a svůj
    // vlastní org_admin profil, a NIC jiného. Jakmile má profil, tahle
    // cesta se pro něj navždy zavře.
    function isProfileLess() {
      return isSignedIn() && !exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // M2 (§4.5): `families`/`fosterPersons` orgAccessList smí RŮST jen o
    // PŘESNĚ jeden záznam a ten musí být vlastní organizace volajícího —
    // nejde takhle přiřadit přístup CIZÍ organizaci. Zkombinováno s
    // `hasOwnAgreementFor` níž (skutečná Dohoda musí existovat) u
    // konkrétních `match` bloků families/fosterPersons — samotná tahle
    // funkce jen hlídá TVAR změny, ne oprávněnost.
    function isValidAccessExtension(oldList, newList, orgId) {
      return newList.size() == oldList.size() + 1 && newList.hasAll(oldList) && (orgId in newList);
    }

    // M2 (§4.5 "Pravidlo čtení": "načíst vlastní Dohodu organizace O pro
    // daný Spis") — Dohoda má DETERMINISTICKÉ ID (= organizationId, viz
    // AgreementDoc komentář), takže se dá číst PŘÍMO na známé cestě
    // `families/{familyId}/agreements/{orgId}`, bez dotazu a beze všech
    // denormalizovaných kopií na Spisu. `familyId` je buď přímo z
    // `match /families/{familyId}` výš, nebo (pro `agreements`/`timeline`/
    // `documents`/`historyDigest` níž, zachycené jako `families/{familyId}`
    // wildcard proměnnou `path`) `path[1]` — `path` z `{path=**}` je typ
    // Path (indexovatelný po segmentech), NE string — `.split('/')[1]`
    // (M2 původní verze) na Firestore i skutečně NASADÍ a ZKOMPILUJE beze
    // varování, ale za běhu tiše selže (Path nemá `.split()`), takže
    // KAŽDÝ zápis/čtení timeline/documents/historyDigest by natvrdo spadl
    // na permission-denied — objeveno a opraveno 2026-07-19 živým testem
    // proti skutečnému Firestore (§11.2 přesně proto testy nejsou
    // formalita). Všechny čtyři kolekce žijí přesně JEDNU úroveň pod
    // families, ne hlouběji.
    function ownAgreementPeriod(familyId) {
      return get(/databases/$(database)/documents/families/$(familyId)/agreements/$(userDoc().organizationId)).data;
    }

    function hasOwnAgreementFor(familyId) {
      return isStaff() &&
        exists(/databases/$(database)/documents/families/$(familyId)/agreements/$(userDoc().organizationId));
    }

    function hasActiveAgreementFor(familyId) {
      return hasOwnAgreementFor(familyId) && ownAgreementPeriod(familyId).status == 'active';
    }

    // M1.5 (§5.5): "30denní okno na kompletní vrácení" po hromadném importu
    // — families/fosterPersons/children/agreements mají jinak `delete: if
    // false` natvrdo (audit stopa, §5), tohle je JEDINÁ, úzce vymezená
    // výjimka. `importJobRef` musí odkazovat na SKUTEČNÝ importJob VLASTNÍ
    // organizace volajícího ve stavu `committed` (ne už `rolled_back` —
    // nejde vrátit dvakrát) — `importService.rollbackImportJob` maže
    // entity JEDNU PO DRUHÉ podle manifestu a teprve nakonec přepne
    // `importJobs/{jobId}.status` na `rolled_back`, takže tahle podmínka
    // platí po celou dobu mazání a přestane platit hned po dokončení.
    function canRollbackImportEntity(importJobRef) {
      return isStaff() && userDoc().role == 'org_admin' && importJobRef != null &&
        get(/databases/$(database)/documents/organizations/$(userDoc().organizationId)/importJobs/$(importJobRef)).data.status == 'committed';
    }

    // M7 — stejný `orgAccessList`/`organizationId` vzor jako `fosterPersons`/
    // `children` samotné, jen jako znovupoužitelná funkce pro jejich nové
    // podkolekce (courses, educationPlans, scheduledActivities, ...).
    function hasFosterPersonAccess(fosterPersonId) {
      return isStaff() &&
        userDoc().organizationId in get(/databases/$(database)/documents/fosterPersons/$(fosterPersonId)).data.orgAccessList;
    }
    function hasChildAccess(childId) {
      return isStaff() &&
        sameOrg(get(/databases/$(database)/documents/children/$(childId)).data.organizationId);
    }

    // ---- users/{uid} ---------------------------------------------------

    match /users/{uid} {
      allow read: if isSignedIn() &&
        (request.auth.uid == uid || sameOrg(resource.data.organizationId));

      // M1 (§6 A9) — tři oddělené cesty, `if false` už neplatí plošně:
      // 1) Bootstrap self-registrace: úplně nový uživatel zakládá SVŮJ
      //    VLASTNÍ profil s rolí `org_admin`, a to jen k organizaci, kterou
      //    (jak dokazuje `createdByUid`) sám před chvílí založil. Nejde
      //    takhle vytvořit cizí/druhý profil ani jinou roli.
      // 2) Org_admin zakládá dalšího zaměstnance (nikdy `superadmin`) ve
      //    SVÉ organizaci — `role` v požadavku musí být validní staff role.
      // 3) M4 (§6 A6): pěstoun po kliknutí na magic link zakládá SVŮJ
      //    VLASTNÍ profil s rolí `pestoun` — ale JEN pokud existuje
      //    odpovídající, dosud NEPOUŽITÁ pozvánka (`foster_invitations/
      //    {email}`, doc ID = e-mail) na PŘESNĚ tu organizaci/rodinu/osobu,
      //    kterou si do vlastního profilu zapisuje. Bez týhle vazby by si
      //    kdokoli mohl založit `pestoun` profil s libovolným
      //    `fosterFamilyId` a číst cizí rodinu — stejný sekvenční vzor
      //    jako bod 1 (pozvánka musí existovat DŘÍV, ne se jen tvarově
      //    podobat).
      allow create: if
        (request.auth.uid == uid && request.resource.data.role == 'org_admin' &&
         get(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)).data.createdByUid == request.auth.uid) ||
        (isStaff() && userDoc().role == 'org_admin' &&
         request.resource.data.organizationId == userDoc().organizationId &&
         request.resource.data.role in [
           'org_admin', 'vedouci_pobocky', 'teamleader',
           'klicova_osoba', 'asistent_ko', 'zamestnanec', 'spolupracovnik'
         ]) ||
        (request.auth.uid == uid && request.resource.data.role == 'pestoun' &&
         request.auth.token.email == request.resource.data.email &&
         exists(/databases/$(database)/documents/foster_invitations/$(request.resource.data.email)) &&
         get(/databases/$(database)/documents/foster_invitations/$(request.resource.data.email)).data.consumedAt == null &&
         get(/databases/$(database)/documents/foster_invitations/$(request.resource.data.email)).data.organizationId == request.resource.data.organizationId &&
         get(/databases/$(database)/documents/foster_invitations/$(request.resource.data.email)).data.familyId == request.resource.data.fosterFamilyId &&
         get(/databases/$(database)/documents/foster_invitations/$(request.resource.data.email)).data.fosterPersonRef == request.resource.data.fosterPersonRef);

      // Sebeúprava: `displayName` + `notifyBirthdays`/`notifyNameDays`
      // (2026-07-23/24, nezávislé přepínače narozeninových a jmeninových
      // upozornění na `/nastaveni/kalendar` — ryze osobní preference,
      // žádná cesta k vlastnímu povýšení role).
      // Org_admin nad zaměstnancem své organizace: `role`/`disabledAt`
      // (soft-delete přes `disabledAt`, nikdy hard delete — audit stopa),
      // nikdy nesahá na `superadmin` roli žádným směrem. DOPLNENI_ZADANI-
      // DO-M5 §1: `fte`/`capacityThresholdOverride` přidány do stejného
      // org_admin disjunktu (kapacita KO, žádný nový bezpečnostní vzor).
      // M9: `collaboratorModules` stejně — jen org_admin smí spolupracovníkovi
      // zapínat/vypínat moduly, NIKDY on sám sobě (nesměl by si sám rozšířit rozsah).
      allow update: if
        (request.auth.uid == uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'notifyBirthdays', 'notifyNameDays', 'avatarUrl'])) ||
        (isStaff() && userDoc().role == 'org_admin' && sameOrg(resource.data.organizationId) &&
         resource.data.role != 'superadmin' && request.resource.data.role != 'superadmin' &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(
           ['role', 'disabledAt', 'displayName', 'fte', 'capacityThresholdOverride', 'collaboratorModules', 'avatarUrl']
         ));

      // Žádný hard delete profilu — jen `disabledAt` (viz update výše).
      allow delete: if false;
    }

    // ---- users/{uid}/starredFamilies/{familyId} — hvězdička, UX 2026-07-21
    //
    // Ryze osobní záložka ("vidí ji jen ten, kdo si ji udělal") — proto
    // JEN vlastník `uid`, žádný `sameOrg`/staff výjimka jako u ostatních
    // `users/{uid}` podkolekcí (ty jsou organizační nastavení, tohle ne).
    match /users/{uid}/starredFamilies/{familyId} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // ---- foster_invitations/{email} — §6 A6, M4 ------------------------
    //
    // Doc ID JE e-mail (viz FosterInvitationDoc komentář). Umožňuje jak
    // staffu spravovat pozvánku, tak nově přihlášenému (ale ještě
    // profil-less) pěstounovi ji přečíst PŘED tím, než si založí vlastní
    // `users/{uid}` profil (`users/{uid}` create pravidlo výš na ni
    // odkazuje přes `get()`).

    match /foster_invitations/{email} {
      allow read: if isSuperadmin() ||
        (isStaff() && sameOrg(resource.data.organizationId)) ||
        (isSignedIn() && request.auth.token.email == email);

      allow create: if isStaff() &&
        request.resource.data.organizationId == userDoc().organizationId &&
        request.resource.data.email == email &&
        request.resource.data.consumedAt == null;

      // Staff (stejná organizace) smí pozvánku kdykoli spravovat/odvolat.
      // Nově přihlášený pěstoun smí NASTAVIT jen `consumedAt`/
      // `consumedByUid` (a jen jednou — `resource.data.consumedAt == null`
      // brání druhému "spotřebování" téže pozvánky), nic jiného.
      allow update: if isSuperadmin() ||
        (isStaff() && sameOrg(resource.data.organizationId)) ||
        (
          isSignedIn() && request.auth.token.email == email &&
          resource.data.consumedAt == null &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['consumedAt', 'consumedByUid'])
        );

      allow delete: if isSuperadmin() || (isStaff() && sameOrg(resource.data.organizationId));
    }

    // ---- counters/{orgId}_{typ} — §4.3 pozn. 2 (UID sekvenční čítač) ----

    match /counters/{counterId} {
      // `resource == null` (čítač ještě nikdy nebyl založen — první alokace
      // UID daného entity typu v týhle organizaci, viz M5 nový `document`
      // typ) MUSÍ projít stejně jako ve `write` pravidlu níž, jinak
      // `resource.data.organizationId` spadne na chybě vyhodnocení pravidla
      // (ne na čisté "not found") a transakce v allocateUid() selže
      // s permission-denied — živě odhaleno při prvním vytvoření dokumentu.
      allow read: if resource == null || sameOrg(resource.data.organizationId);
      // Zápis jen přes transakci ze service vrstvy (allocateUid) — libovolný
      // isStaff v dané organizaci smí spustit transakci, samotné zvýšení
      // hodnoty i tak zůstává atomické na úrovni Firestore transakce.
      allow write: if isStaff() &&
        (resource == null || sameOrg(resource.data.organizationId)) &&
        sameOrg(request.resource.data.organizationId);
    }

    // ---- systemCounters/orgCode — §4.3 (OOOO segment, JEDINÝ globální
    // čítač v systému, přiděluje kód organizacím samotným) --------------

    match /systemCounters/orgCode {
      // Jen profil-less self-registrace smí číst/zvyšovat — jakmile má
      // uživatel profil (a tedy i organizaci), tahle cesta se pro něj
      // navždy zavře. Skutečná unikátnost čísla je zaručená Firestore
      // transakcí ve service vrstvě (allocateOrgCode), pravidlo tady jen
      // omezuje KDO smí transakci vůbec spustit.
      allow read, write: if isProfileLess();
    }

    // ---- organizations/{orgId} — §4.1/§4.3, §6 A9 ----------------------

    match /organizations/{orgId} {
      allow read: if isSuperadmin() || sameOrg(orgId);

      // Bootstrap: jen profil-less uživatel, který zakládá SEBE jako
      // vlastníka (createdByUid). `orgCode` musí mít tvar OOOO — skutečná
      // unikátnost přichází z systemCounters/orgCode transakce výše.
      allow create: if isProfileLess() &&
        request.resource.data.createdByUid == request.auth.uid &&
        request.resource.data.orgCode is string &&
        request.resource.data.orgCode.matches('[0-9]{4}');

      // Jen org_admin (plný přístup) nebo superadmin — vedení má podle
      // §5.7 matice jen READ (žádná editace), proto tu není.
      allow update: if isSuperadmin() ||
        (isStaff() && userDoc().role == 'org_admin' && sameOrg(orgId));

      allow delete: if false;
    }

    // ---- organizations/{orgId}/enumOptions/{listId} — Cesta B 2026-07-23 -
    //
    // Vlastní (org-scoped) položky "otevřených" číselníků (typ události…) —
    // ZÁMĚRNĚ volnější než `organizations/{orgId}` samotný: KTERÝKOLI
    // zaměstnanec organizace smí přidat novou položku (ne jen org_admin),
    // protože jde o nízko-rizikovou popisnou taxonomii bez byznys logiky
    // navázané na konkrétní hodnotu (na rozdíl od `role`/`careType`, které
    // ZŮSTÁVAJÍ pevné enumy — na těch je postavená autorizace/§47a výpočet
    // hodin). Delete zatím záměrně není (žádná položka se nemaže, jen
    // přibývají — nejjednodušší bezpečné chování, stejný vzor jako
    // `importJobs`).
    match /organizations/{orgId}/enumOptions/{listId} {
      allow read: if isSuperadmin() || sameOrg(orgId);
      allow create, update: if isStaff() && sameOrg(orgId);
      allow delete: if false;
    }

    // ---- platformDefaults/{docId} — DOPLNENI_ZADANI-DO-M5 §1 bod 3 -----
    //
    // Jediný globální singleton (`global`), nejnižší úroveň kaskády prahu
    // kapacity KO. Čtou VŠICHNI přihlášení (potřebují ho k dopočtu
    // efektivního prahu, viz computeEffectiveCapacityThreshold), zapisuje
    // VÝHRADNĚ superadmin — žádná organizace nemá jinou cestu k platformní
    // konfiguraci.
    match /platformDefaults/{docId} {
      allow read: if isSignedIn();
      allow write: if isSuperadmin();
    }

    // ---- organizations/{orgId}/importJobs/{jobId} — §5.5, M1.5 -----------
    //
    // §5.7 matice: "Import dat" — org_admin plný, vedení jen historie úloh
    // (READ, žádná editace). `stagingRecords` podkolekce dědí přesně
    // stejné scoping (žádný vlastní `organizationId` na záznamu — čte se
    // z rodičovského `importJobs/{jobId}` dokumentu). Update na `importJobs`
    // je záměrně bez omezení POLÍ (na rozdíl od `users`) — commit/rollback
    // mění `status`/`manifest`/`committedAt` najednou, service vrstva
    // (importService.ts) je jediné volající místo, ne uživatel ručně.

    match /organizations/{orgId}/importJobs/{jobId} {
      allow read: if isSuperadmin() || sameOrg(orgId);
      allow create: if isStaff() && userDoc().role == 'org_admin' && sameOrg(orgId);
      allow update: if isSuperadmin() ||
        (isStaff() && userDoc().role == 'org_admin' && sameOrg(orgId));
      allow delete: if false;

      match /stagingRecords/{recordId} {
        allow read: if isSuperadmin() || sameOrg(orgId);
        allow create, update: if isStaff() && userDoc().role == 'org_admin' && sameOrg(orgId);
        allow delete: if false;
      }
    }

    // ---- organizations/{orgId}/backupConfig/config — §5.5, M1.5 ----------
    // ---- organizations/{orgId}/backupJobs/{jobId} ------------------------
    //
    // §5.7 matice: "Zálohy" — org_admin plný, vedení jen stav (READ).
    // `backupConfig` je jediný dokument (ID vždy `config`, viz backup.ts).

    match /organizations/{orgId}/backupConfig/config {
      allow read: if isSuperadmin() || sameOrg(orgId);
      allow write: if isSuperadmin() ||
        (isStaff() && userDoc().role == 'org_admin' && sameOrg(orgId));
    }

    match /organizations/{orgId}/backupJobs/{jobId} {
      allow read: if isSuperadmin() || sameOrg(orgId);
      allow create: if isStaff() && userDoc().role == 'org_admin' && sameOrg(orgId);
      allow update: if isSuperadmin() ||
        (isStaff() && userDoc().role == 'org_admin' && sameOrg(orgId));
      allow delete: if false;
    }

    // ---- organizations/{orgId}/auditLog/{entryId} — NEMĚNITELNÁ stopa ----
    //
    // Viz src/types/auditLog.ts pro to, PROČ log existuje a co nezaručuje.
    // Tady je jeho jediná skutečná záruka, a proto stojí za přesné čtení:
    //
    // 1. NEJDE ZMĚNIT ANI SMAZAT. `update`/`delete` jsou `false` pro
    //    VŠECHNY, superadmina včetně. Log, který umí smazat ten, koho
    //    zaznamenává, není log. Když bude potřeba záznamy odstranit
    //    (retenční lhůta), udělá se to mimo klienta — vědomým zásahem
    //    přes admin SDK, ne funkcí v aplikaci.
    // 2. NEJDE PODEPSAT CIZÍM JMÉNEM. `actorUid == request.auth.uid`.
    // 3. ČAS JE SERVEROVÝ. `serverAt == request.time` — klient si nemůže
    //    záznam antedatovat. Pole `at` (klientské) slouží jen k řazení a
    //    zobrazení; při sporu platí `serverAt`.
    // 4. ZŮSTÁVÁ VE SVÉ ORGANIZACI. `sameOrg(orgId)` — přenos spisu mezi
    //    organizacemi proto zapisuje DVA záznamy, každý u sebe. Obojí je
    //    pravdivé tvrzení o tom, co ta která organizace udělala.
    //
    // Čte vedení a správce organizace (log je nástroj kontroly NAD
    // pracovníky, ne pracovní pomůcka) — plus superadmin.

    match /organizations/{orgId}/auditLog/{entryId} {
      allow read: if isSuperadmin() ||
        (sameOrg(orgId) && userDoc().role in ['org_admin', 'vedouci_pobocky', 'teamleader']);

      allow create: if isStaff() && sameOrg(orgId) &&
        request.resource.data.organizationId == orgId &&
        request.resource.data.actorUid == request.auth.uid &&
        request.resource.data.serverAt == request.time &&
        request.resource.data.action is string &&
        request.resource.data.category is string &&
        request.resource.data.actorName is string &&
        request.resource.data.actorRole is string &&
        request.resource.data.at is string;

      allow update, delete: if false;
    }

    // ---- titleRegistry/{uid} — REJSTŘÍK OBSAZENÝCH UID -------------------
    //
    // Metodika MPSV: osoba pečující smí mít v daném čase jen jeden právní
    // titul doprovázení. Vynutit se to jinde nedá — Dohodu cizí organizace
    // NEPŘEČTE (`sameOrg` níž u `agreements`), takže bez tohohle rejstříku
    // systém o cizím titulu neví a "zablokovat" znamená blokovat naslepo.
    //
    // Čte KAŽDÝ zaměstnanec, i z organizace bez jakéhokoli vztahu k té
    // osobě — o to právě jde, ptá se ten, kdo zatím nic nemá. Proto
    // v dokumentu NEJSOU ŽÁDNÉ OSOBNÍ ÚDAJE (viz types/titleRegistry.ts):
    // odpověď zní "obsazeno/volno, kým a dokdy", nic víc.
    //
    // `list` je ZAKÁZANÝ. Bez toho by šel rejstřík stáhnout celý a z něj
    // odvodit, kolik případů která organizace vede — to nikomu nepřísluší.
    // Sáhnout jde jen na konkrétní UID, které se tazatel dozvěděl jinde.
    //
    // ZÁPIS: založit smí kdokoli (první organizace, co UID zavede), ale
    // PŘEPSAT jen držitel — nebo kdokoli, když je titul označený za
    // ukončený (`validTo != null`). Tím je strukturálně vyloučené, že si
    // organizace přetáhne UID, u kterého běží OTEVŘENÝ titul někoho jiného.
    //
    // ČEHO SE TOHLE PRAVIDLO NEDOTKNE, ať to není překvapení: `validTo`
    // v budoucnosti se tu od `validTo` v minulosti odlišit nedá (uložené
    // je ISO string, `request.time` je timestamp — nesrovnatelné typy).
    // Titul s naplánovaným koncem tedy jde přepsat i před tím koncem.
    // Časovou platnost hlídá `isTitleRunning` v aplikaci; pravidla drží tu
    // podstatnou část — otevřený titul je nedotknutelný.
    //
    // `delete` je zakázaný pro všechny kromě superadmina: smazaný záznam
    // vypadá stejně jako "tohle UID jsme nikdy neviděli".

    match /titleRegistry/{uid} {
      allow get: if isSuperadmin() || isStaff();
      allow list: if false;

      allow create: if isStaff() &&
        request.resource.data.uid == uid &&
        request.resource.data.updatedByOrgId == userDoc().organizationId;

      allow update: if isSuperadmin() || (
        isStaff() &&
        request.resource.data.uid == uid &&
        request.resource.data.updatedByOrgId == userDoc().organizationId && (
          resource.data.holderOrgId == userDoc().organizationId ||
          resource.data.validTo != null
        )
      );

      allow delete: if isSuperadmin();
    }

    // ---- organizations/{orgId}/backupRestoreTests/{id} — §5.5 gate, M1.5 -
    //
    // POVINNÝ GATE před produkčním nasazením zálohy/obnovení (§5.5) —
    // platformní ověřovací záznam, ne organizační operativní data. Zapisuje
    // VÝHRADNĚ superadmin (kdo skutečně provedl test obnovy na izolovaném
    // prostředí), organizace svůj vlastní záznam vidí (transparentnost), ale
    // nemůže si "sama sobě" test odškrtnout.

    match /organizations/{orgId}/backupRestoreTests/{id} {
      allow read: if isSuperadmin() || sameOrg(orgId);
      allow write: if isSuperadmin();
    }

    // ---- families/{familyId} — SPIS, §4.1/§4.5, M2 -----------------------
    //
    // `orgAccessList` (M2) nahrazuje M1 dočasné `createdByOrgId` — každá
    // organizace, co kdy měla s rodinou Dohodu, čte Spis navždy (§4.5:
    // "vlastní období: vidí VŠE... natrvalo, i po skončení vlastní
    // Dohody"). Update smí buď (a) měnit cokoli KROMĚ orgAccessList (běžná
    // úprava adresy/pěstounů organizací, co už přístup má), nebo (b)
    // rozšířit orgAccessList o PŘESNĚ vlastní organizaci volajícího, A JEN
    // pokud pro ni existuje SKUTEČNÁ Dohoda na tomhle Spisu
    // (`families/{familyId}/agreements/{organizationId}`, viz
    // `hasOwnAgreementFor`) — bez týhle kontroly by šlo přiřadit přístup
    // JAKÉKOLI organizaci prostým zavoláním update, bez jakékoli Dohody
    // (reálná díra, odhalená a opravená při psaní téhle sady pravidel).
    // `agreementService.ts` proto VŽDY zakládá Dohodu jako PRVNÍ zápis,
    // teprve pak rozšiřuje seznam (stejný sekvenční vzor jako M1
    // registrace) — a rules teď TUHLE posloupnost i reálně vyžadují, ne
    // jen předpokládají.

    match /families/{familyId} {
      // M4: pěstoun čte VÝHRADNĚ svou vlastní rodinu (`fosterFamilyId` na
      // jeho `users/{uid}` profilu, vyplněné jen z ověřené pozvánky — viz
      // `users/{uid}` create pravidlo výš).
      allow read: if isSuperadmin() ||
        (isStaff() && userDoc().organizationId in resource.data.orgAccessList) ||
        (isFoster() && familyId == userDoc().fosterFamilyId);

      allow create: if isStaff() &&
        request.resource.data.orgAccessList == [userDoc().organizationId];

      allow update: if isSuperadmin() || (
        isStaff() && (
          (
            userDoc().organizationId in resource.data.orgAccessList &&
            request.resource.data.orgAccessList == resource.data.orgAccessList
          ) ||
          (
            isValidAccessExtension(resource.data.orgAccessList, request.resource.data.orgAccessList, userDoc().organizationId) &&
            hasOwnAgreementFor(familyId)
          )
        )
      );

      allow delete: if isSuperadmin() || (
        userDoc().organizationId in resource.data.orgAccessList &&
        canRollbackImportEntity(resource.data.createdByImportJobRef)
      );
    }

    // ---- children/{childId} — TOP-LEVEL dle §4.2 bod 7, M1 základ ------
    //
    // Stejný SEAM jako families výše: `organizationId` je teď přímo
    // nastavené při založení, ale §4.2 bod 7 říká, že se má denormalizovat
    // z AKTIVNÍ DOHODY (M2) — až Dohoda existuje, přepsat na skutečnou
    // denormalizaci při každé změně přiřazení, ne nechávat jako statické
    // pole z M1.

    match /children/{childId} {
      // M4: pěstoun čte děti VLASTNÍ rodiny (read-only, §2 "své děti
      // read-only") — porovnává se `familyId` na dítěti, ne organizace
      // (dítě může mít jinou aktuální `organizationId` než pěstounův
      // vlastní vztah, viz §4.2 bod 7 denormalizace, ale rodina zůstává).
      allow read: if isSuperadmin() || sameOrg(resource.data.organizationId) ||
        (isFoster() && resource.data.familyId == userDoc().fosterFamilyId) ||
        hasCollaboratorAssignment('child', childId);
      allow create: if isStaff() &&
        request.resource.data.organizationId == userDoc().organizationId;
      allow update: if isSuperadmin() || sameOrg(resource.data.organizationId);
      allow delete: if isSuperadmin() || (
        sameOrg(resource.data.organizationId) &&
        canRollbackImportEntity(resource.data.createdByImportJobRef)
      );
    }

    // ---- fosterPersons/{fosterId} — TOP-LEVEL, §4.4.A, M2 ----------------
    //
    // Stejný `orgAccessList` model a stejná oprava jako `families` výš
    // (§4.4.A: pěstoun jako osoba přežívá změnu Dohody/organizace, stejná
    // logika jako Spis) — rozšíření orgAccessList vyžaduje skutečnou
    // Dohodu na `resource.data.familyId` (rodina, ke které pěstoun patří),
    // ne jen tvarově validní seznam. `agreementService.ts` rozšiřuje
    // orgAccessList tady souběžně s `family.orgAccessList` při založení
    // Dohody, pro VŠECHNY pěstouny dané rodiny.

    match /fosterPersons/{fosterId} {
      // M4: pěstoun čte VLASTNÍ osobu i případného spolupěstouna stejné
      // rodiny (stejné `familyId`) — ne cizí rodiny.
      allow read: if isSuperadmin() ||
        (isStaff() && userDoc().organizationId in resource.data.orgAccessList) ||
        (isFoster() && resource.data.familyId == userDoc().fosterFamilyId) ||
        hasCollaboratorAssignment('fosterPerson', fosterId);

      allow create: if isStaff() &&
        request.resource.data.orgAccessList == [userDoc().organizationId];

      allow update: if isSuperadmin() || (
        isStaff() && (
          (
            userDoc().organizationId in resource.data.orgAccessList &&
            request.resource.data.orgAccessList == resource.data.orgAccessList
          ) ||
          (
            isValidAccessExtension(resource.data.orgAccessList, request.resource.data.orgAccessList, userDoc().organizationId) &&
            hasOwnAgreementFor(resource.data.familyId)
          )
        )
      );

      allow delete: if isSuperadmin() || (
        userDoc().organizationId in resource.data.orgAccessList &&
        canRollbackImportEntity(resource.data.createdByImportJobRef)
      );
    }

    // ---- families/{familyId}/agreements/{agreementId} — DOHODA, §4.5, M2 -
    //
    // `{path=**}` wildcard match (ne `families/{familyId}/agreements/...`
    // přímo) — potřebné pro COLLECTION GROUP dotaz napříč rodinami (kapacita
    // KO, §6 A9: "kolik aktivních Dohod má KO X", `collectionGroup('agreements')`
    // filtrovaný na `assignedTo`+`status`+`organizationId` — poslední
    // jmenované musí zrcadlit tohle pravidlo, jinak Firestore dotaz zamítne,
    // stejná past jako u `children`/`families` v M1). `agreementId` MUSÍ
    // rovnat se `organizationId` (deterministické ID, viz AgreementDoc) —
    // tohle zajišťuje "nejvýš jedna Dohoda na organizaci" STRUKTURÁLNĚ
    // (druhý pokus je update stejného dokumentu, ne kolize), ne runtime
    // kontrolou.

    match /{path=**}/agreements/{agreementId} {
      // `resource == null` — rodina bez Dohody zatím vůbec (běžný, UI
      // podporovaný stav, `FamilyDetailPage.tsx` "Zatím žádná Dohoda…"),
      // `agreementId == organizationId` znamená `getActiveAgreement` čte
      // dokument, co ještě neexistuje — bez týhle pojistky `resource.data`
      // na `null` shodí CELÝ `getDoc` chybou vyhodnocení pravidel (živě
      // odhaleno 2026-07-23, ne teoreticky), místo aby vrátil "neexistuje"
      // (stejný idiom už používá `orgCodeCounters` výš).
      allow read: if resource == null || isSuperadmin() || sameOrg(resource.data.organizationId);

      allow create: if isStaff() &&
        request.resource.data.organizationId == userDoc().organizationId &&
        agreementId == userDoc().organizationId;

      allow update: if isSuperadmin() || sameOrg(resource.data.organizationId);
      allow delete: if isSuperadmin() || (
        sameOrg(resource.data.organizationId) &&
        canRollbackImportEntity(resource.data.createdByImportJobRef)
      );
    }

    // ---- families/{familyId}/timeline/{id} — ZADANI §4.1/§7/§4.5, M2 -----
    //
    // Plný záznam čte VÝHRADNĚ organizace, co ho vytvořila — NIKDY cizí
    // organizace, ani ta co má/měla vlastní Dohodu (§4.5 "Pravidlo čtení"
    // bod 1-2: cizí čtou jen historyDigest, nikdy tohle). M2 staví jen
    // pravidla + typ (`TimelineEntryDoc`) — skutečný zápisník/UI a
    // `historyDigest` generování z tohohle přichází s M3. `path` je vždy
    // `families/{familyId}` (jedna úroveň vnoření), takže `path[1]` je
    // Firestore document ID rodiče (viz `ownAgreementPeriod` komentář výš
    // pro `path[1]` vs. `.split('/')[1]` — tohle je opravená verze, M3).

    match /{path=**}/timeline/{entryId} {
      // §7.4 "private (sobě)" — SEAM: zkusil jsem sem 2026-07-19 přidat
      // podmínku `sharingLevel != 'private' || createdByUid == volající`,
      // aby cizí "Soukromá poznámka" nešla přečíst kolegovi ze STEJNÉ
      // organizace (co dnes projde přes tohle pravidlo). ŽIVĚ TO ALE
      // ROZBILO `listTimelineEntries` napříč appkou — Firestore u `list`
      // dotazu zamítne CELÝ dotaz (ne jen tiše vynechá pár dokumentů),
      // pokud pravidlo čte pole, které dotaz sám nefiltruje (§5 "List
      // dotaz vs. pole v pravidle" past, stejná co je zdokumentovaná
      // jinde v tomhle souboru — jen jsem na ni tentokrát sám nedbal).
      // Vráceno zpátky na jen `sameOrg`. Skutečná oprava vyžaduje BUD
      // query `or()` filtr zrcadlený i v pravidle (nový composite index),
      // NEBO přesun `private` poznámek do samostatné podkolekce — obojí
      // je SEAM pro budoucí průchod, ne narychlo teď v noci bez možnosti
      // to nechat doběhnout index a ověřit. Do té doby je "Soukromá
      // poznámka" vynucená jen na úrovni KLIENTA (`listTimelineEntries`
      // filtruje `sharingLevel==='private' && createdByUid!==aktuální`),
      // ne na úrovni Firestore pravidel — stejná důvěra ve staff jako
      // jinde v appce, ne tvrdá bezpečnostní hranice.
      // M4 (§13.3 sjednocení): pěstoun čte VÝHRADNĚ zápisy vlastní rodiny
      // se sharingLevel 'foster' — jediná úroveň, kterou smí vidět (§7.4:
      // "foster (KO↔pěstoun, jediná úroveň viditelná pěstounovi)").
      // Podmínka MUSÍ přesně zrcadlit klientský dotaz
      // (`listFosterVisibleTimelineEntries`, `where('sharingLevel','==',
      // 'foster')` + `where('subjectRefs','array-contains',{kind:'family',
      // id:familyId})`) — jinak Firestore zamítne CELÝ list dotaz (živě
      // ověřeno na vlastní kůži hodinu předtím, viz komentář výš u
      // "Soukromá poznámka" SEAMu). Rodina je VŽDY v `subjectRefs`
      // (implicitní subjekt, viz FamilyDetailPage.openRecorderFor), takže
      // tahle jedna podmínka pokrývá i zápisy o konkrétním dítěti/pěstounovi.
      //
      // DOPLNENI_ZADANI-DO-M5 §2 (2026-07-20): druhý disjunkt PRO
      // fosterPerson-scoped zápisy — "Sdílet s oběma pěstouny" VYPNUTO v
      // zápisníku nahrazuje family-level subjectRef konkrétním
      // `{kind:'fosterPerson', id}`, takže druhý partner ho vůbec nemá
      // vidět. Musí přesně zrcadlit `mojeService.
      // listFosterVisiblePersonalTimelineEntries` dotaz stejným způsobem
      // jako family-branch výš.
      allow read: if isSuperadmin() || sameOrg(resource.data.createdByOrgId) ||
        (
          isFoster() && path[1] == userDoc().fosterFamilyId &&
          resource.data.sharingLevel == 'foster' &&
          resource.data.subjectRefs.hasAny([{'kind': 'family', 'id': userDoc().fosterFamilyId}])
        ) ||
        (
          isFoster() && path[1] == userDoc().fosterFamilyId &&
          resource.data.sharingLevel == 'foster' &&
          resource.data.subjectRefs.hasAny([{'kind': 'fosterPerson', 'id': userDoc().fosterPersonRef}])
        );
      allow create: if isStaff() &&
        request.resource.data.createdByOrgId == userDoc().organizationId &&
        hasActiveAgreementFor(path[1]);
      allow update, delete: if false; // append-only, §5
    }

    // ---- families/{familyId}/messages/{id} — Chat, M9 --------------------
    //
    // Na rozdíl od `timeline` výš (jen staff zakládá) je tohle OBOUSMĚRNÉ
    // vlákno — pěstoun i staff zakládají zápisy do STEJNÉ podkolekce.
    // `audience` (sharing.ts §7.4 "messages.audience") — staff smí zapsat
    // 'foster' (skutečná zpráva) i 'internal' (interní poznámka k vláknu,
    // pěstoun ji nikdy neuvidí); pěstoun VÝHRADNĚ 'foster' (jediná úroveň,
    // kterou sám vidí — nemá smysl mu dovolit zapsat cokoli jiného).
    // `private`/`ospod` nemají v chatu smysl (dvoustranná konverzace, OSPOD
    // nemá portál), proto je ani jeden disjunkt níž nepovoluje, i když typ
    // (`SharingLevel`) je sdílený se `sharing.ts`.
    //
    // Čtení: staff vidí CELÉ vlákno (`sameOrg`, stejně jako timeline),
    // pěstoun jen `audience == 'foster'` zápisy vlastní rodiny — musí
    // přesně zrcadlit `mojeService.listFosterVisibleMessages` dotaz (§5
    // "List dotaz vs. pole v pravidle", stejná past jako u timeline výš).
    //
    // Spolupracovník (M9) NEMÁ přístup — chat je KO↔pěstoun věc, není v
    // seznamu jeho modulů (`collaborator.ts`), a `isCollaborator()` tu
    // záměrně není použité, stejně jako `isStaff()` ho jinde vylučuje.
    match /{path=**}/messages/{messageId} {
      allow read: if isSuperadmin() || sameOrg(resource.data.createdByOrgId) ||
        (
          isFoster() && path[1] == userDoc().fosterFamilyId &&
          resource.data.audience == 'foster'
        );
      allow create: if isSuperadmin() ||
        (
          isStaff() &&
          request.resource.data.createdByOrgId == userDoc().organizationId &&
          request.resource.data.authorRole == 'staff' &&
          request.resource.data.createdByUid == request.auth.uid &&
          request.resource.data.audience in ['foster', 'internal'] &&
          hasActiveAgreementFor(path[1])
        ) ||
        (
          isFoster() && path[1] == userDoc().fosterFamilyId &&
          request.resource.data.createdByOrgId == userDoc().organizationId &&
          request.resource.data.authorRole == 'foster' &&
          request.resource.data.createdByUid == request.auth.uid &&
          request.resource.data.audience == 'foster'
        );
      allow update, delete: if false; // append-only, stejně jako timeline
    }

    // ---- families/{familyId}/documents/{docId} — ZADANI §6 A1, M5 --------
    //
    // Plný automat (M2 měla jen pravidla + zjednodušený český placeholder
    // typ pro §4.5 fixtures, viz FamilyDocumentDoc komentář pro celý
    // stavový diagram + interpretační rozhodnutí ohledně
    // `closed_ko_unapproved`). Tři oddělené `update` cesty podle role —
    // KAŽDÁ smí zapsat JEN status hodnoty vyhrazené jejímu kroku, nikdy
    // status cizího kroku (pěstoun nikdy `closed`, staff nikdy
    // `commented`/`approved_foster`, vedení jen z `mgmt_review`). Přesná
    // posloupnost/odvození `closed_*_unapproved` z `fosterApprovedAt`/
    // `assignedKoApprovedAt` hlídá `documentService.ts`, ne rules — rules
    // tady hlídají KDO smí psát KTEROU cílovou hodnotu (bezpečnostní
    // hranice), ne přesnou obchodní logiku přechodu (stejný dělicí vzor
    // jako `organizations/{orgId}/importJobs` update výš).
    //
    // Čtení pěstounem (§6 A1 "pěstoun jen krok 4 a jen u viditelných
    // dokumentů"): NIKDY `draft` (ještě není poslaný), cokoli pozdějšího
    // ANO — jednou viditelný zápis zůstává viditelný i po uzavření
    // (stejná logika jako u ostatních §4.5 vzorů, ne mizí po schválení).

    match /{path=**}/documents/{docId} {
      allow read: if isSuperadmin() || sameOrg(resource.data.createdByOrgId) ||
        (
          isFoster() && resource.data.familyId == userDoc().fosterFamilyId &&
          resource.data.status != 'draft'
        );

      allow create: if isStaff() &&
        request.resource.data.createdByOrgId == userDoc().organizationId &&
        request.resource.data.status == 'draft' &&
        hasActiveAgreementFor(path[1]);

      allow update: if isSuperadmin() ||
        (
          // KO/staff — kroky 1–6 a 8 (editace, poslání pěstounovi, Konečný,
          // poslání vedení, odeslání na úřad/založení do spisu).
          isStaff() && sameOrg(resource.data.createdByOrgId) &&
          request.resource.data.createdByOrgId == resource.data.createdByOrgId &&
          request.resource.data.familyId == resource.data.familyId &&
          request.resource.data.status in
            ['draft', 'foster_review', 'final', 'mgmt_review', 'sent', 'filed']
        ) ||
        (
          // Pěstoun — VÝHRADNĚ krok 4, VÝHRADNĚ z `foster_review`, VÝHRADNĚ
          // vlastní rodina, NIKDY nesahá na obsah (`body`/`title`).
          isFoster() && resource.data.familyId == userDoc().fosterFamilyId &&
          resource.data.status == 'foster_review' &&
          request.resource.data.status in ['commented', 'approved_foster'] &&
          request.resource.data.createdByOrgId == resource.data.createdByOrgId &&
          request.resource.data.familyId == resource.data.familyId &&
          request.resource.data.body == resource.data.body &&
          request.resource.data.title == resource.data.title
        ) ||
        (
          // Vedení — VÝHRADNĚ krok 7, VÝHRADNĚ z `mgmt_review`. §5.7
          // "vedení READ-ONLY" má tady VĚDOMOU výjimku (schvalování
          // dokumentů JE jejich práce), stejně jako u prodlužování
          // legislativních lhůt jinde v projektu.
          isStaff() && sameOrg(resource.data.createdByOrgId) &&
          (userDoc().role == 'org_admin' || isReadOnlyManager()) &&
          resource.data.status == 'mgmt_review' &&
          request.resource.data.status in
            ['closed', 'closed_foster_unapproved', 'closed_ko_unapproved', 'closed_both_unapproved', 'draft']
        );

      allow delete: if false;
    }

    // `versions` jako SAMOSTATNÝ (ne vnořený) match — vnořené `match
    // /versions/{versionId}` uvnitř `{path=**}/documents/{docId}` bloku
    // výš se živě ukázalo jako nefunkční (`hasActiveAgreementFor(path[1])`
    // uvnitř dvojitě vnořeného matche vždy spadlo na permission-denied,
    // i když identická podmínka na `documents/{docId}` samotném prošla) —
    // ploché zápis o úroveň výš, stejný `{path=**}` vzor, ale BEZ vnoření,
    // věc funguje spolehlivě.
    match /{path=**}/documents/{docId}/versions/{versionId} {
      allow read: if isSuperadmin() || sameOrg(resource.data.createdByOrgId);
      allow create: if isStaff() &&
        request.resource.data.createdByOrgId == userDoc().organizationId &&
        hasActiveAgreementFor(path[1]);
      allow update, delete: if false; // append-only, §5
    }

    // ---- families/{familyId}/historyDigest/{id} — "nutné minimum", §4.5, M2
    //
    // JÁDRO §4.5. Tři cesty ke čtení:
    // 1. Vlastní záznam (createdByOrgId == volající) — vždy, natrvalo.
    // 2. Cizí záznam, jehož segmentValidTo (konec Dohody TVŮRCE) je ROVNO
    //    NEBO STARŠÍ než validFrom VLASTNÍ Dohody volajícího pro tenhle
    //    Spis (`<=`, přesně dle §4.5 doslovného znění) — dřívější
    //    organizace, digest čitelný.
    // 3. Cizí záznam vzniklý PO konci vlastní Dohody volajícího
    //    (segmentValidTo je null NEBO pozdější než vlastní validFrom) —
    //    ŽÁDNÝ přístup, ani na digest (§4.5 "Pravidlo čtení" bod 3).
    // `ownAgreementPeriod`/`hasOwnAgreementFor` čtou vlastní Dohodu volající
    // organizace přímo na jejím deterministickém ID (`get()`) — přesně to
    // "načíst vlastní Dohodu organizace O pro daný Spis", které §4.5 sám
    // předjímá jako nutné a přijatelné (čte se jen jednou za request, ne
    // per záznam).

    match /{path=**}/historyDigest/{digestId} {
      allow read: if isSuperadmin() ||
        sameOrg(resource.data.createdByOrgId) ||
        (
          hasOwnAgreementFor(path[1]) &&
          resource.data.segmentValidTo != null &&
          resource.data.segmentValidTo <= ownAgreementPeriod(path[1]).validFrom
        );

      // M3 živě ověřeno (2026-07-19): tohle pravidlo (M2) chybělo zrcadlit
      // sesterská `timeline`/`documents` pravidla o řádek výš — nekontrolovalo
      // `hasActiveAgreementFor(path[1])`, takže LIBOVOLNÝ staff účet JAKÉKOLI
      // organizace mohl založit `historyDigest` záznam pod CIZÍ rodinou, se
      // kterou jeho organizace nikdy neměla vůbec žádnou Dohodu — M2 na tohle
      // nedopadlo, protože žádný kód historyDigest reálně nezakládal až do
      // M3 (`timelineService.createVisitTimelineEntry`), takže mezera se
      // nikdy neprojevila. `createVisitTimelineEntry` už tuhle podmínku sama
      // splňuje (stejný batch má i `timeline` zápis, který ji vyžaduje) —
      // tahle oprava jen uzavírá cestu MIMO app (přímé volání Firestore SDK).
      allow create: if isStaff() &&
        request.resource.data.createdByOrgId == userDoc().organizationId &&
        hasActiveAgreementFor(path[1]);
      allow update, delete: if false; // append-only, §5
    }

    // ==== M6+M7 — NOVE-ZADANI-M6-AZ-KONEC.md ============================
    //
    // Všechny nové podkolekce používají PEVNOU (ne `{path=**}` wildcard)
    // cestu, i tam, kde by to teoreticky šlo zkrátit — živě objevený bug
    // dřív v tomhle souboru byl přesně o VNOŘENÉM matchi uvnitř `{path=**}`
    // bloku (viz `documents/versions` komentář výš); žádný z těchhle bloků
    // není vnořený, ale radši žádné nové riziko, nedá se to tuhle dávku
    // živě odladit stejným tempem jako dřív (Petr testuje na seed datech
    // teprve PO nasazení).

    // ---- legislativeParameters/{key}/history — §B.1, vrchol VŠECH kaskád

    match /legislativeParameters/{key}/history/{entryId} {
      allow read: if isSignedIn();
      allow create: if isSuperadmin();
      allow update, delete: if false; // append-only, verzované
    }

    // ---- fosterPersons/{fosterId}/rateOverrides + policyOverrides — §B.5/B.5.1

    match /fosterPersons/{fosterPersonId}/rateOverrides/{key}/history/{entryId} {
      allow read: if isSuperadmin() || hasFosterPersonAccess(fosterPersonId);
      allow create: if hasFosterPersonAccess(fosterPersonId);
      allow update, delete: if false;
    }
    match /fosterPersons/{fosterPersonId}/policyOverrides/{key}/history/{entryId} {
      allow read: if isSuperadmin() || hasFosterPersonAccess(fosterPersonId);
      allow create: if hasFosterPersonAccess(fosterPersonId);
      allow update, delete: if false;
    }

    // ---- families/{familyId}/agreements/{agreementId}/rateOverrides + policyOverrides
    //
    // `agreementId` JE `organizationId` (deterministické ID Dohody, M2) —
    // `sameOrg(agreementId)` je tedy přesně "vlastní organizace týhle Dohody".

    match /families/{familyId}/agreements/{agreementId}/rateOverrides/{key}/history/{entryId} {
      allow read: if isSuperadmin() || sameOrg(agreementId);
      allow create: if sameOrg(agreementId);
      allow update, delete: if false;
    }
    match /families/{familyId}/agreements/{agreementId}/policyOverrides/{key}/history/{entryId} {
      allow read: if isSuperadmin() || sameOrg(agreementId);
      allow create: if sameOrg(agreementId);
      allow update, delete: if false;
    }

    // ---- organizations/{orgId}/rateOverrides + policyOverrides — org_admin only zápis

    match /organizations/{orgId}/rateOverrides/{key}/history/{entryId} {
      allow read: if isSuperadmin() || sameOrg(orgId);
      allow create: if isStaff() && userDoc().role == 'org_admin' && sameOrg(orgId);
      allow update, delete: if false;
    }
    match /organizations/{orgId}/policyOverrides/{key}/history/{entryId} {
      allow read: if isSuperadmin() || sameOrg(orgId);
      allow create: if isStaff() && userDoc().role == 'org_admin' && sameOrg(orgId);
      allow update, delete: if false;
    }

    // ---- users/{koUid}/policyOverrides — NOVÁ úroveň kaskády, §B.5.1

    match /users/{koUid}/policyOverrides/{key}/history/{entryId} {
      allow read: if isSuperadmin() ||
        (isStaff() && sameOrg(get(/databases/$(database)/documents/users/$(koUid)).data.organizationId));
      allow create: if isStaff() && userDoc().role == 'org_admin' &&
        sameOrg(get(/databases/$(database)/documents/users/$(koUid)).data.organizationId);
      allow update, delete: if false;
    }

    // ---- fosterPersons/{fosterId} vzdělávání/dávky — §4.4.A/§4.4.D, §6 A10a

    match /fosterPersons/{fosterPersonId}/courses/{courseId} {
      allow read: if isSuperadmin() || hasFosterPersonAccess(fosterPersonId);
      allow create: if hasFosterPersonAccess(fosterPersonId);
      allow update, delete: if false; // trvalá historie, nikdy se nemaže
    }
    match /fosterPersons/{fosterPersonId}/benefitChecks/{id} {
      allow read: if isSuperadmin() || hasFosterPersonAccess(fosterPersonId);
      allow create: if hasFosterPersonAccess(fosterPersonId);
      allow update, delete: if false; // append-only audit
    }
    match /fosterPersons/{fosterPersonId}/educationPlans/{id} {
      allow read: if isSuperadmin() || hasFosterPersonAccess(fosterPersonId);
      allow create, update: if hasFosterPersonAccess(fosterPersonId);
      allow delete: if false;
    }
    // §6 A10a/A10b + §B.5.1 anti-fraud: `isFosterReimbursement=true` BEZ
    // `reimbursementReason` musí selhat i při přímém volání API, ne jen v
    // UI — vynuceno tady, ne jen v `courseService.ts`.
    match /fosterPersons/{fosterPersonId}/courseEnrollments/{id} {
      allow read: if isSuperadmin() || hasFosterPersonAccess(fosterPersonId);
      allow create: if hasFosterPersonAccess(fosterPersonId) &&
        (request.resource.data.isFosterReimbursement != true || request.resource.data.reimbursementReason != null);
      allow update: if isSuperadmin() || (
        hasFosterPersonAccess(fosterPersonId) &&
        (request.resource.data.isFosterReimbursement != true || request.resource.data.reimbursementReason != null)
      );
      allow delete: if false;
    }

    // ---- children/{childId} podkolekce — §4.4.B.1/§4.4.E

    match /children/{childId}/scheduledActivities/{activityId} {
      allow read: if isSuperadmin() || hasChildAccess(childId);
      allow create, update: if hasChildAccess(childId);
      allow delete: if false;
    }
    match /children/{childId}/scheduledActivities/{activityId}/occurrences/{occId} {
      allow read: if isSuperadmin() || hasChildAccess(childId);
      allow create, update: if hasChildAccess(childId);
      allow delete: if false;
    }
    match /children/{childId}/supportExpenses/{id} {
      allow read: if isSuperadmin() || hasChildAccess(childId);
      allow create: if hasChildAccess(childId);
      allow update, delete: if false; // append-only doklady
    }

    // ---- families/{familyId} podkolekce — respit/asistovaný kontakt/handover

    match /families/{familyId}/respitEvents/{id} {
      allow read: if isSuperadmin() || sameOrg(resource.data.organizationId);
      allow create: if isStaff() &&
        request.resource.data.organizationId == userDoc().organizationId &&
        hasActiveAgreementFor(familyId);
      allow update: if isSuperadmin() || sameOrg(resource.data.organizationId); // vedení doplňuje doklady u Pobytu
      allow delete: if false;
    }
    match /families/{familyId}/assistedContactSeries/{id} {
      allow read: if isSuperadmin() || sameOrg(resource.data.organizationId);
      allow create: if isStaff() &&
        request.resource.data.organizationId == userDoc().organizationId &&
        hasActiveAgreementFor(familyId);
      allow update: if isSuperadmin() || sameOrg(resource.data.organizationId);
      allow delete: if false;
    }
    match /families/{familyId}/assistedContactSeries/{seriesId}/occurrences/{id} {
      allow read: if isSuperadmin() ||
        (isStaff() && sameOrg(get(/databases/$(database)/documents/families/$(familyId)/assistedContactSeries/$(seriesId)).data.organizationId));
      allow create, update: if isStaff() &&
        sameOrg(get(/databases/$(database)/documents/families/$(familyId)/assistedContactSeries/$(seriesId)).data.organizationId);
      allow delete: if false;
    }
    match /families/{familyId}/childHandovers/{id} {
      allow read: if isSuperadmin() || sameOrg(resource.data.organizationId);
      allow create: if isStaff() &&
        request.resource.data.organizationId == userDoc().organizationId &&
        hasActiveAgreementFor(familyId);
      // UX zpětná vazba 2026-07-21 — editace povolena (dřív `if false`,
      // takže nešel opravit ani překlep). Vlastní organizace smí měnit
      // obsah, ale NE "přeadresovat" záznam jinam (organizationId/childRef
      // musí zůstat). Delete pořád zakázaný — audit stopa.
      allow update: if isSuperadmin() || (
        sameOrg(resource.data.organizationId) &&
        request.resource.data.organizationId == resource.data.organizationId &&
        request.resource.data.childRef == resource.data.childRef
      );
      allow delete: if false;
    }

    // ---- families/{familyId}/agreements/{agreementId}/ippd — §B.4

    match /families/{familyId}/agreements/{agreementId}/ippd/{id} {
      allow read: if isSuperadmin() || sameOrg(agreementId);
      allow create: if isStaff() &&
        request.resource.data.organizationId == agreementId &&
        hasActiveAgreementFor(familyId);
      allow update: if isSuperadmin() || sameOrg(agreementId);
      allow delete: if false;
    }

    // ---- organizations/{orgId} podkolekce — SPVPP/inspekce, §4.4.C/§B.6

    match /organizations/{orgId}/spvpp/{year} {
      allow read: if isSuperadmin() || sameOrg(orgId);
      allow create, update: if isStaff() && sameOrg(orgId);
      allow delete: if false;
    }
    match /organizations/{orgId}/spvpp/{year}/expenses/{id} {
      allow read: if isSuperadmin() || sameOrg(orgId);
      allow create: if isStaff() && sameOrg(orgId);
      allow update, delete: if false; // append-only
    }
    match /organizations/{orgId}/inspections/{id} {
      allow read: if isSuperadmin() || sameOrg(orgId);
      allow create: if isStaff() && sameOrg(orgId);
      allow update: if isSuperadmin() || sameOrg(orgId); // nápravná opatření se doplňují
      allow delete: if false;
    }

    // ---- organizations/{orgId}/calendarEvents/{id} — Kalendář ------------
    //
    // Sdílený týmový kalendář — na rozdíl od skoro celé appky (append-only)
    // se tenhle typ SKUTEČNĚ upravuje (přetažení na jiný čas/den v
    // `CalendarPage.tsx`), ne jen zakládá. `update` nesmí měnit
    // `organizationId`/`createdByUid` (identita záznamu), cokoli jiného
    // (čas, název, komu je přiřazená, status) smí přepsat KTERÝKOLI staff
    // stejné organizace — sdílený kalendář, ne soukromé silo (stejná
    // důvěra napříč staff rolemi jako jinde v appce). `delete: if false`
    // zůstává i tady (§5 audit stopa přesně jako všude jinde) — "zrušit"
    // v UI nastaví `status:'zruseno'`, nikdy nemaže dokument.
    match /organizations/{orgId}/calendarEvents/{eventId} {
      allow read: if isSuperadmin() || sameOrg(orgId);
      allow create: if isSuperadmin() ||
        (
          isStaff() && sameOrg(orgId) &&
          request.resource.data.organizationId == orgId &&
          request.resource.data.createdByUid == request.auth.uid
        );
      allow update: if isSuperadmin() ||
        (
          isStaff() && sameOrg(orgId) &&
          request.resource.data.organizationId == resource.data.organizationId &&
          request.resource.data.createdByUid == resource.data.createdByUid
        );
      allow delete: if false;
    }

    // ---- organizations/{orgId}/tasks/{id} — Úkoly ------------------------
    //
    // Stejná pravidla jako `calendarEvents` výš (viz tam komentář pro plné
    // zdůvodnění) — sdílený staff seznam úkolů, `update` nesmí měnit
    // identitu záznamu (`organizationId`/`createdByUid`), `delete: if
    // false` (§5 audit stopa — "hotovo"/"zrušeno" je stav, ne mazání).
    match /organizations/{orgId}/tasks/{taskId} {
      allow read: if isSuperadmin() || sameOrg(orgId);
      allow create: if isSuperadmin() ||
        (
          isStaff() && sameOrg(orgId) &&
          request.resource.data.organizationId == orgId &&
          request.resource.data.createdByUid == request.auth.uid
        );
      allow update: if isSuperadmin() ||
        (
          isStaff() && sameOrg(orgId) &&
          request.resource.data.organizationId == resource.data.organizationId &&
          request.resource.data.createdByUid == resource.data.createdByUid
        );
      allow delete: if false;
    }

    // ---- fosterProspects/{id} — TOP-LEVEL, obyčejné Firestore ID, §B.7

    match /fosterProspects/{id} {
      allow read: if isSuperadmin() || sameOrg(resource.data.organizationId);
      allow create: if isStaff() && request.resource.data.organizationId == userDoc().organizationId;
      allow update: if isSuperadmin() || sameOrg(resource.data.organizationId);
      allow delete: if false;
    }
    match /fosterProspects/{prospectId}/notes/{id} {
      allow read: if isSuperadmin() ||
        (isStaff() && sameOrg(get(/databases/$(database)/documents/fosterProspects/$(prospectId)).data.organizationId));
      allow create: if isStaff() &&
        sameOrg(get(/databases/$(database)/documents/fosterProspects/$(prospectId)).data.organizationId);
      allow update, delete: if false;
    }

    // ---- external_participants/{id} — TOP-LEVEL, §5.1 základ (jen CRUD;
    // plný 3-krokový grant engine je M8, samostatný modul)

    match /external_participants/{epId} {
      allow read: if isSuperadmin() || sameOrg(resource.data.organizationId);
      allow create: if isStaff() && request.resource.data.organizationId == userDoc().organizationId;
      allow update: if isSuperadmin() || sameOrg(resource.data.organizationId);
      allow delete: if false;

      // ---- external_participants/{epId}/access/{entityId}/grants/{grantId} — M8, §5.1
      //
      // Plný grant/permission engine. `entityId` je docId DÍTĚTE NEBO
      // PĚSTOUNA (viz `ExternalEntityType` v src/types/externalParticipant.ts)
      // — `access/{entityId}` je jen cesta, žádný vlastní dokument (grants
      // scoping se čte z rodičovského externisty, stejná "žádné vlastní
      // organizationId" past jako u M1.5 importJobs/stagingRecords). Citlivá
      // oprávnění (viz PERMISSION_KEYS v src/types/externalParticipant.ts —
      // drž seznam SYNCHRONNÍ) MUSÍ projít `requested→approved→active` (3
      // role, ne nutně 3 různí lidé — "3 aktéři" čteme jako 3 ROLE v
      // řetězci, ne vynucení tří odlišných uid). Necitlivá = `grantDirect`,
      // rovnou `active`, jeden krok. `revoke` = update na status 'revoked'
      // (nastavuje `validTo` v service vrstvě), NIKDY delete — proto
      // `allow delete: if false` napořád.
      match /access/{entityId}/grants/{grantId} {
        function participantOrgId() {
          return get(/databases/$(database)/documents/external_participants/$(epId)).data.organizationId;
        }
        function isSensitive(key) {
          return key in ['viewMedical', 'signDocuments', 'chatWith', 'videoCalls'];
        }
        // request (citlivé) i grantDirect (necitlivé): KO/asistent/org_admin.
        function canRequest() {
          return isStaff() && userDoc().role in ['klicova_osoba', 'asistent_ko', 'org_admin'] && sameOrg(participantOrgId());
        }
        // schválení a zamítnutí: vedení organizace.
        function canApprove() {
          return isStaff() && userDoc().role in ['org_admin', 'vedouci_pobocky', 'teamleader'] && sameOrg(participantOrgId());
        }
        // aktivace: samostatný, užší krok — jen org_admin.
        function canActivate() {
          return isStaff() && userDoc().role == 'org_admin' && sameOrg(participantOrgId());
        }
        function canRevoke() {
          return isStaff() && userDoc().role in ['org_admin', 'vedouci_pobocky', 'teamleader'] && sameOrg(participantOrgId());
        }
        // update nesmí "cestou" změnit, KOMU/ČEMU grant patří — jen status/audit pole.
        function sameGrantIdentity() {
          return request.resource.data.permissionKey == resource.data.permissionKey;
        }

        allow read: if isSuperadmin() || sameOrg(participantOrgId());

        allow create: if isSuperadmin() ||
          (canRequest() && !isSensitive(request.resource.data.permissionKey) && request.resource.data.status == 'active') ||
          (canRequest() && isSensitive(request.resource.data.permissionKey) && request.resource.data.status == 'requested');

        allow update: if isSuperadmin() || (sameGrantIdentity() && (
          (canApprove() && resource.data.status == 'requested' && request.resource.data.status == 'approved') ||
          (canApprove() && resource.data.status == 'requested' && request.resource.data.status == 'rejected') ||
          (canActivate() && resource.data.status == 'approved' && request.resource.data.status == 'active') ||
          (canRevoke() && resource.data.status in ['requested', 'approved', 'active'] && request.resource.data.status == 'revoked')
        ));

        allow delete: if false;
      }
    }

    // ---- organizations/{orgId}/externalRoleTemplates/{id} — M8, §5.1 -----
    //
    // Jen zkratka pro VYPLNĚNÍ formuláře (předvyplní defaultPermissions),
    // NE pro obejití schvalování — citlivá oprávnění pořád projdou celým
    // `requestGrant→approveGrant→activateGrant` řetězcem výš, ať pochází
    // odkudkoli. Nízká citlivost dat → čtení všem ve staffu, zápis jen org_admin.

    match /organizations/{orgId}/externalRoleTemplates/{id} {
      allow read: if isSuperadmin() || sameOrg(orgId);
      allow write: if isSuperadmin() || (isStaff() && userDoc().role == 'org_admin' && sameOrg(orgId));
    }

    // ---- collaboratorAssignments/{collaboratorUid}_{entityType}_{entityId} — M9, Spolupracovník
    //
    // Deterministické ID (stejný vzor jako Dohoda, viz AgreementDoc) —
    // umožňuje `children`/`fosterPersons` pravidlům výš ověřit "má tenhle
    // spolupracovník přiřazenou tuhle osobu" přímým `exists()`, bez dotazu.
    // Zakládá/ruší KO/vedení (isStaff() téhle organizace) — NIKDY sám
    // spolupracovník (nesměl by si sám rozšířit rozsah). Žádný update —
    // přeřazení je smazat + založit nový záznam.
    match /collaboratorAssignments/{assignmentId} {
      allow read: if isSuperadmin() || sameOrg(resource.data.organizationId) ||
        (isCollaborator() && request.auth.uid == resource.data.collaboratorUid);

      allow create: if isStaff() &&
        request.resource.data.organizationId == userDoc().organizationId &&
        assignmentId == request.resource.data.collaboratorUid + '_' + request.resource.data.entityType + '_' + request.resource.data.entityId;

      allow update: if false;
      allow delete: if isSuperadmin() || sameOrg(resource.data.organizationId);

      // ---- .../entries/{entryId} — spolupracovníkův VLASTNÍ pracovní zápis
      // (výkaz práce), ZÁMĚRNĚ oddělený od families/{id}/timeline — viz
      // CollaboratorEntryDoc doc komentář (src/types/collaborator.ts) pro
      // proč. Append-only, stejně jako zbytek historie v appce.
      match /entries/{entryId} {
        function parentAssignment() {
          return get(/databases/$(database)/documents/collaboratorAssignments/$(assignmentId)).data;
        }
        allow read: if isSuperadmin() || sameOrg(parentAssignment().organizationId) ||
          (isCollaborator() && request.auth.uid == parentAssignment().collaboratorUid);

        allow create: if isCollaborator() &&
          request.auth.uid == parentAssignment().collaboratorUid &&
          request.resource.data.createdByUid == request.auth.uid &&
          collaboratorModuleEnabled('writeTimeline');

        allow update, delete: if false;
      }
    }

    // ---- Vše ostatní: default deny, dokud modul nepřidá vlastní match ---

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
