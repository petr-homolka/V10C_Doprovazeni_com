# Zkopíruj do .env.local (nikdy necommitovat .env.local) a doplň skutečné
# hodnoty z Firebase Console. Nikdy do repozitáře nedávej reálné hodnoty.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 'true' = SDK se připojí na lokální Firestore/Auth emulátor (firebase.json)
# místo produkce. Používat vždy pro lokální vývoj.
VITE_USE_FIREBASE_EMULATORS=true

# App Check (M10, viz lib/firebase.ts) — reCAPTCHA v3 site key z Firebase
# Console → App Check. Volitelné — bez něj appka běží dál, jen "AI souhrn"
# (lib/ai.ts) nebude mít App Check ochranu.
VITE_RECAPTCHA_SITE_KEY=
